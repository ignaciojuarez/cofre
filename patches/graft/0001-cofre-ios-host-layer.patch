-	/** Wraps an existing CAMetalLayer (retained here). */
+	/** Wraps an existing CAMetalLayer (retained here). On iOS the layer belongs to a live UIView: configure it on main. */
 	public MetalSurface(MetalDevice device, long layer) {
 		this.device = device;
 		this.layer = retain(layer);
-		send(layer, sel("setDevice:"), device.device);
-		send(layer, sel("setPixelFormat:"), Mtl.PIXEL_BGRA8);
-		send(layer, sel("setFramebufferOnly:"), 1L);
-		send(layer, sel("setMaximumDrawableCount:"), 3L);
-		setColorspace(layer, MetalConfig.displayP3 ? "kCGColorSpaceDisplayP3" : "kCGColorSpaceSRGB");
+		onLayerThread(() -> {
+			send(layer, sel("setDevice:"), device.device);
+			send(layer, sel("setPixelFormat:"), Mtl.PIXEL_BGRA8);
+			send(layer, sel("setFramebufferOnly:"), 1L);
+			send(layer, sel("setMaximumDrawableCount:"), 3L);
+			// CAMetalLayer.colorspace is macOS 10.11+ / iOS 16+; iOS treats an untagged drawable as sRGB anyway.
+			if (send(layer, sel("respondsToSelector:"), sel("setColorspace:")) != 0L) {
+				setColorspace(layer, MetalConfig.displayP3 ? "kCGColorSpaceDisplayP3" : "kCGColorSpaceSRGB");
+			}
+		});
+	}
+
+	/** iOS: the launcher's own CAMetalLayer (Graft does not create, resize or replace it; Air owns frame and scale). */
+	public static MetalSurface forIosHost(MetalDevice device) {
+		return new MetalSurface(device, IosHost.hostLayer());
+	}
+
+	private static void onLayerThread(Runnable body) {
+		if (IosHost.ACTIVE) {
+			IosHost.onMain(body);
+		} else {
+			body.run();
+		}
 	}
 
 	/** Without an explicit colorspace macOS shows the drawable in the display's native gamut, oversaturating sRGB content. */
@@ -83,8 +103,21 @@ public final class MetalSurface implements AutoCloseable {
 	public void configure(int width, int height, boolean vsync) {
 		this.width = width;
 		this.height = height;
-		Calls.setDrawableSize(layer, width, height);
-		send(layer, sel("setDisplaySyncEnabled:"), vsync ? 1L : 0L);
+		// Called every frame: only touch the layer when something changed (on iOS each write is a main-queue hop).
+		int sync = vsync ? 1 : 0;
+		if (width == layerWidth && height == layerHeight && sync == layerVsync) {
+			return;
+		}
+		layerWidth = width;
+		layerHeight = height;
+		layerVsync = sync;
+		onLayerThread(() -> {
+			Calls.setDrawableSize(layer, width, height);
+			// displaySyncEnabled is macOS-only (an unrecognized selector on iOS, where presentation always syncs).
+			if (!IosHost.ACTIVE) {
+				send(layer, sel("setDisplaySyncEnabled:"), sync);
+			}
+		});
 	}
 
 	/** Returns false if no drawable became available (window hidden or timeout). */
