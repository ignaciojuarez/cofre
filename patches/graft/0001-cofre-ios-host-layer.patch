From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cofre <cofre@example.invalid>
Date: Sat, 31 Oct 2026 15:00:00 -0700
Subject: [PATCH] [COFRE] Run Graft's 1.21.11 Metal renderer on iOS

Reason: Graft v1.1.1 is macOS-only: it installs a CAMetalLayer on the GLFW Cocoa NSView, translates shaders for the macOS MSL platform, calls the macOS-only CAMetalLayer.displaySyncEnabled, and nests macOS shaderc/SPIRV-Cross natives. On iOS (Air) it must present through the launcher's published UIView CAMetalLayer with inline layer setup (an FFM upcall to reach the main queue SIGBUSes on iOS), target iOS MSL, and use the launcher's signed iOS shaderc/SPIRV-Cross.
Drop when: Graft ships an iOS host-layer path (or a generic "external CAMetalLayer" hook) and an iOS MSL target upstream.
---
diff --git a/COFRE-NOTICE.md b/COFRE-NOTICE.md
new file mode 100644
index 0000000..a82d22e
--- /dev/null
+++ b/COFRE-NOTICE.md
@@ -0,0 +1,14 @@
+# Cofre iOS build of Graft
+
+This jar is a modified build of Graft (https://github.com/kkorenn/Graft, tag v1.1.1,
+commit 4386b98945178da071ba0ffe0b7a1e7e57eddb97), licensed under the GNU Lesser General
+Public License v3.0 (LICENSE_graft in this jar).
+
+Modified by Cofre (2026-10-31) to run on iOS inside the Air launcher:
+- detect iOS and present through the launcher's published UIView/CAMetalLayer
+  (layer writes on the main queue) instead of an AppKit NSView;
+- translate shaders for the iOS Metal platform (SPIRV-Cross MSL iOS target);
+- use the launcher's signed shaderc/SPIRV-Cross libraries instead of bundled macOS natives;
+- build only the Minecraft 1.21.11 Fabric module.
+
+The exact changes and build recipe are in the Cofre repository: patches/graft/ and scripts/graft.sh.
diff --git a/core/src/main/java/dev/graft/metal/IosHost.java b/core/src/main/java/dev/graft/metal/IosHost.java
new file mode 100644
index 0000000..abfc77a
--- /dev/null
+++ b/core/src/main/java/dev/graft/metal/IosHost.java
@@ -0,0 +1,126 @@
+package dev.graft.metal;
+
+import java.lang.foreign.Arena;
+import java.lang.foreign.FunctionDescriptor;
+import java.lang.foreign.MemoryLayout;
+import java.lang.foreign.MemorySegment;
+import java.lang.invoke.MethodHandle;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Locale;
+
+import static dev.graft.metal.ObjC.*;
+import static java.lang.foreign.ValueLayout.*;
+
+/**
+ * iOS host integration (Cofre/Air, Amethyst, PojavLauncher). There is no AppKit window: the launcher owns a UIView whose
+ * backing layer is a CAMetalLayer and publishes its address as {@code -Dmetallum.ios.view.pointer=0x...}. UIKit and
+ * layer configuration runs inline on the render thread (see onMain); Air has already attached the layer to the view.
+ */
+public final class IosHost {
+	/** -Dgraft.ios=true|false overrides detection. */
+	public static final boolean ACTIVE = detect();
+
+	private IosHost() {
+	}
+
+	private static boolean detect() {
+		String forced = System.getProperty("graft.ios");
+		if (forced != null) {
+			return Boolean.parseBoolean(forced);
+		}
+		String os = System.getProperty("os.name", "").toLowerCase(Locale.ROOT);
+		if (os.contains("ios") || System.getProperty("metallum.ios.view.pointer") != null) {
+			return true;
+		}
+		// iOS JVMs may report "Mac OS X"/"Darwin". UIKit is loaded in every iOS app process and never in a desktop JVM.
+		// (Air registers AppKit stub classes, so the absence of NSApplication is not a usable signal.)
+		return (os.contains("mac") || os.contains("darwin")) && ObjC.classOrZero("UIApplication") != 0L;
+	}
+
+	/**
+	 * Runs body for "main-queue" layer work. Inline on purpose: dispatching to the main queue needs an FFM upcall stub,
+	 * and HotSpot's upcall-stub creation SIGBUSes on iOS (CodeBlob written into the read-execute code cache, iPad mini
+	 * iPadOS 27). Stock MetalUniversal configures the same Air-published CAMetalLayer from the render thread and works.
+	 */
+	public static void onMain(Runnable body) {
+		body.run();
+	}
+
+	/** The launcher's game UIView: -Dgraft.ios.view.pointer, Air/Metallum's property, Pojav's, then +[SurfaceViewController surface]. */
+	public static long hostView() {
+		for (String key : new String[]{"graft.ios.view.pointer", "metallum.ios.view.pointer", "pojav.view.pointer"}) {
+			String raw = System.getProperty(key);
+			if (raw != null && !raw.isBlank()) {
+				raw = raw.trim();
+				long view = Long.parseUnsignedLong(raw.startsWith("0x") || raw.startsWith("0X") ? raw.substring(2) : raw, 16);
+				if (view != 0L) {
+					return view;
+				}
+			}
+		}
+		long[] view = new long[1];
+		long controller = ObjC.classOrZero("SurfaceViewController");
+		if (controller != 0L) {
+			onMain(() -> view[0] = send(controller, sel("surface")));
+		}
+		if (view[0] == 0L) {
+			throw new IllegalStateException("Graft: no iOS game view. The launcher must pass -Dmetallum.ios.view.pointer=<UIView address>.");
+		}
+		return view[0];
+	}
+
+	/** The host view's own CAMetalLayer (not retained). Graft never creates or replaces the layer on iOS. */
+	public static long hostLayer() {
+		long view = hostView();
+		long[] layer = new long[1];
+		onMain(() -> {
+			long l = send(view, sel("layer"));
+			if (l == 0L || (send(l, sel("isKindOfClass:"), cls("CAMetalLayer")) & 0xFF) == 0) {
+				throw new IllegalStateException("Graft: the iOS game view's layer is not a CAMetalLayer");
+			}
+			layer[0] = l;
+		});
+		System.out.println("[Graft] iOS host layer " + Long.toHexString(layer[0]) + " from view " + Long.toHexString(view));
+		return layer[0];
+	}
+
+	/** Major OS version from NSProcessInfo (os.version is not reliable on iOS JVMs). */
+	public static int osMajor() {
+		MemoryLayout version = MemoryLayout.structLayout(JAVA_LONG, JAVA_LONG, JAVA_LONG);
+		MethodHandle get = ObjC.custom(FunctionDescriptor.of(version, JAVA_LONG, JAVA_LONG));
+		try (Arena arena = Arena.ofConfined()) {
+			MemorySegment v = (MemorySegment)get.invokeExact((java.lang.foreign.SegmentAllocator)arena, send(cls("NSProcessInfo"), sel("processInfo")), sel("operatingSystemVersion"));
+			return (int)v.get(JAVA_LONG, 0);
+		} catch (Throwable t) {
+			return 0;
+		}
+	}
+
+	/**
+	 * Points LWJGL's shaderc and SPIRV-Cross at the launcher's signed iOS libraries (app Frameworks, on
+	 * java.library.path) unless the launcher already chose them. Must run before Shaderc/Spvc are first initialized.
+	 */
+	public static void prepareNatives() {
+		pick("org.lwjgl.shaderc.libname", "libshaderc.dylib");
+		pick("org.lwjgl.spvc.libname", "libspirv-cross-c-shared.0.dylib", "libspvc.dylib");
+	}
+
+	private static void pick(String property, String... files) {
+		if (System.getProperty(property) != null) {
+			System.out.println("[Graft] iOS " + property + "=" + System.getProperty(property) + " (launcher)");
+			return;
+		}
+		for (String dir : System.getProperty("java.library.path", "").split(java.io.File.pathSeparator)) {
+			for (String file : files) {
+				Path path = Path.of(dir, file);
+				if (!dir.isEmpty() && Files.isRegularFile(path)) {
+					System.setProperty(property, path.toString());
+					System.out.println("[Graft] iOS " + property + "=" + path);
+					return;
+				}
+			}
+		}
+		System.out.println("[Graft] iOS " + property + " not found on java.library.path; LWJGL default lookup");
+	}
+}
