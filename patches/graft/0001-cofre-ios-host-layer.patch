+	/**
+	 * dlopen by absolute path (macOS and iOS keep these system paths in the dyld shared cache). If a launcher's dlopen
+	 * hook refuses the path, fall back to dlsym(RTLD_DEFAULT): an iOS app already links Metal, QuartzCore and libobjc.
+	 */
+	public static SymbolLookup library(String path) {
+		try {
+			return SymbolLookup.libraryLookup(path, Arena.global());
+		} catch (IllegalArgumentException e) {
+			MethodHandle dlsym = LINKER.downcallHandle(LINKER.defaultLookup().find("dlsym").orElseThrow(), FunctionDescriptor.of(ADDRESS, JAVA_LONG, ADDRESS));
+			Arena arena = Arena.global();
+			return name -> {
+				try {
+					MemorySegment symbol = (MemorySegment)dlsym.invokeExact(-2L /* RTLD_DEFAULT */, arena.allocateFrom(name));
+					return symbol.address() == 0L ? java.util.Optional.empty() : java.util.Optional.of(symbol);
+				} catch (Throwable t) {
+					throw rethrow(t);
+				}
+			};
+		}
+	}
+
 	static MethodHandle fn(SymbolLookup lib, String name, FunctionDescriptor desc) {
 		return LINKER.downcallHandle(lib.find(name).orElseThrow(() -> new UnsatisfiedLinkError(name)), desc);
 	}
