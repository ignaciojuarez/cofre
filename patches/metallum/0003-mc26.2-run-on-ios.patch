diff --git a/src/main/java/com/metallum/render/MetalCommandEncoder.java b/src/main/java/com/metallum/render/MetalCommandEncoder.java
index edd9420..511a331 100644
--- a/src/main/java/com/metallum/render/MetalCommandEncoder.java
+++ b/src/main/java/com/metallum/render/MetalCommandEncoder.java
@@ -9,7 +9,6 @@ import com.mojang.blaze3d.textures.GpuTextureView;
 import io.github.kokodio.metaljvm.metal.*;
 import io.github.kokodio.metaljvm.objc.AutoreleasePool;
 import io.github.kokodio.metaljvm.objc.ObjC;
-import io.github.kokodio.metaljvm.objc.ObjCBlock;
 import io.github.kokodio.metaljvm.quartzcore.CAMetalLayer;
 import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
 import net.fabricmc.api.EnvType;
@@ -22,8 +21,8 @@ import org.jspecify.annotations.Nullable;
 import java.nio.ByteBuffer;
 import java.nio.ByteOrder;
 import java.util.*;
-import java.util.concurrent.Semaphore;
 import java.util.concurrent.TimeUnit;
+import java.util.concurrent.locks.LockSupport;
 
 @Environment(EnvType.CLIENT)
 final class MetalCommandEncoder implements CommandEncoderBackend {
@@ -31,8 +30,6 @@ final class MetalCommandEncoder implements CommandEncoderBackend {
     private final MetalDevice device;
     private long currentSubmitIndex = MAX_SUBMITS_IN_FLIGHT;
     private final InFlight[] inFlight = new InFlight[MAX_SUBMITS_IN_FLIGHT];
-    private final Semaphore[] submitSemaphores = new Semaphore[MAX_SUBMITS_IN_FLIGHT];
-    private final long[] submitSignalBlocks = new long[MAX_SUBMITS_IN_FLIGHT];
     private final MetalDestructionQueue destroyQueue = new MetalDestructionQueue(MAX_SUBMITS_IN_FLIGHT);
     private final MetalTransientMemory transientMemory;
     private final Map<MetalGpuTexture, Vector4fc> pendingColorClears = new IdentityHashMap<>();
@@ -54,11 +51,8 @@ final class MetalCommandEncoder implements CommandEncoderBackend {
         this.device = device;
         this.transientMemory = new MetalTransientMemory(device, this);
         fence = MetalUtilities.nonNil(device.metalDevice().newFence(), "newFence");
-        for (int slot = 0; slot < MAX_SUBMITS_IN_FLIGHT; slot++) {
-            Semaphore semaphore = new Semaphore(0);
-            submitSemaphores[slot] = semaphore;
-            submitSignalBlocks[slot] = ObjCBlock.withRunnable(semaphore::release);
-        }
+        // Cofre: no completion-handler blocks. An Objective-C block needs an FFM upcall stub, and creating one
+        // SIGBUSes on iOS; awaitSubmitCompletion polls the retained command buffer's status instead.
     }
 
     MTLCommandBuffer commandBuffer() {
@@ -119,8 +113,6 @@ final class MetalCommandEncoder implements CommandEncoderBackend {
             endEncoder();
 
             int slot = (int) (currentSubmitIndex % MAX_SUBMITS_IN_FLIGHT);
-            submitSemaphores[slot].drainPermits();
-            commandBuffer.addCompletedHandler(submitSignalBlocks[slot]);
             commandBuffer.commit();
 
             toClose = inFlight[slot];
@@ -139,6 +131,7 @@ final class MetalCommandEncoder implements CommandEncoderBackend {
 
         transientMemory.rotate();
         destroyQueue.rotate();
+        IosHost.drainFramePool();
     }
 
     MTLRenderCommandEncoder renderCommandEncoder(
@@ -625,16 +618,33 @@ final class MetalCommandEncoder implements CommandEncoderBackend {
         int slot = (int) (submitIndex % MAX_SUBMITS_IN_FLIGHT);
         InFlight f = inFlight[slot];
         if (f != null && f.index == submitIndex) {
-            Semaphore semaphore = submitSemaphores[slot];
-            try {
-                if (!semaphore.tryAcquire(Math.max(timeoutMs, 0L), TimeUnit.MILLISECONDS)) {
-                    return false;
-                }
-                semaphore.release();
-                return true;
-            } catch (InterruptedException e) {
-                throw new IllegalStateException("Render thread interrupted while waiting for Metal submit completion", e);
+            return awaitCompleted(f.buffer, timeoutMs);
+        }
+        return true;
+    }
+
+    private static boolean isDone(final MTLCommandBuffer buffer) {
+        return buffer.status().value >= MTLCommandBufferStatus.Completed.value;
+    }
+
+    private static boolean awaitCompleted(final MTLCommandBuffer buffer, final long timeoutMs) {
+        if (isDone(buffer)) {
+            return true;
+        }
+        if (timeoutMs <= 0L) {
+            return false;
+        }
+        if (timeoutMs >= 1000L) {
+            // The per-frame wait. Metal's GPU watchdog ends a hung command buffer with an error, so this returns.
+            buffer.waitUntilCompleted();
+            return true;
+        }
+        long deadline = System.nanoTime() + TimeUnit.MILLISECONDS.toNanos(timeoutMs);
+        while (!isDone(buffer)) {
+            if (System.nanoTime() >= deadline) {
+                return false;
             }
+            LockSupport.parkNanos(50_000L);
         }
         return true;
     }
diff --git a/src/main/java/com/metallum/render/MetalCompiledRenderPipeline.java b/src/main/java/com/metallum/render/MetalCompiledRenderPipeline.java
index 914e9d5..b12fd12 100644
--- a/src/main/java/com/metallum/render/MetalCompiledRenderPipeline.java
+++ b/src/main/java/com/metallum/render/MetalCompiledRenderPipeline.java
@@ -52,9 +52,10 @@ final class MetalCompiledRenderPipeline implements CompiledRenderPipeline, AutoC
     private final MTLDepthStencilState depthStencilState;
     private final MetalDevice device;
     @Nullable
-    private final MTLRenderPipelineDescriptor descriptor;
+    private MTLRenderPipelineDescriptor descriptor;
     private final int fullLayout;
     private final Int2ObjectOpenHashMap<MTLRenderPipelineState> pipelinesByLayout = new Int2ObjectOpenHashMap<>();
+    private boolean closed;
 
     MetalCompiledRenderPipeline(
             final MetalDevice device,
@@ -226,6 +227,10 @@ final class MetalCompiledRenderPipeline implements CompiledRenderPipeline, AutoC
 
     @Nullable
     MTLRenderPipelineState getNativePipeline(final int passLayout) {
+        if (this.closed) {
+            // Cofre: a closed pipeline's descriptor is released; building a variant from it is a use-after-free.
+            return null;
+        }
         int layout = passLayout & this.fullLayout;
         MTLRenderPipelineState pipeline = this.pipelinesByLayout.get(layout);
         if (pipeline == null && !this.pipelinesByLayout.containsKey(layout)) {
@@ -309,14 +314,22 @@ final class MetalCompiledRenderPipeline implements CompiledRenderPipeline, AutoC
 
     @Override
     public void close() {
+        if (this.closed) {
+            return;
+        }
+        this.closed = true;
+        // Cofre: resource reloads (Graphics, mipmaps, resource packs) close pipelines mid-frame. The open encoder and
+        // up to MAX_SUBMITS_IN_FLIGHT committed command buffers may still use these states, so release them through
+        // the destruction queue like every other Metal object instead of immediately.
         for (MTLRenderPipelineState pipeline : this.pipelinesByLayout.values()) {
             if (pipeline != null) {
-                pipeline.release();
+                this.device.queueResourceRelease(pipeline);
             }
         }
         this.pipelinesByLayout.clear();
         if (this.descriptor != null) {
-            this.descriptor.release();
+            this.device.queueResourceRelease(this.descriptor);
+            this.descriptor = null;
         }
     }
 }
