-            throw new BackendCreationException("NSView handle is null", BackendCreationException.Reason.GLFW_ERROR);
-        }
-
         CAMetalLayer metalLayer;
-        try {
-            metalLayer = CAMetalLayer.alloc().init();
+        if (IosHost.ACTIVE) {
+            // Cofre: no AppKit window on iOS; Air owns the game UIView and its CAMetalLayer (frame, scale).
+            Metallum.LOGGER.info("Metallum: iOS host detected; presenting through the launcher's CAMetalLayer");
