From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cofre <cofre@example.invalid>
Date: Wed, 28 Oct 2026 22:00:00 -0700
Subject: [PATCH] [TYPE] Embed CofreKit and PacketTunnel

Reason: compile the UI-agnostic bridge and package the packet tunnel with the host.
Drop when: Air exposes an official extension integration point.
--- a/Natives/CMakeLists.txt
+++ b/Natives/CMakeLists.txt
@@ -380,6 +380,7 @@ add_executable(AngelAuraAmethyst
   main_hook.m
+  ${COFRE_SOURCE_DIR}/app/Glue/AirBridge/AirBridgeAdapter.m
@@ -700,6 +701,7 @@
 target_link_libraries(AngelAuraAmethyst
+  ${COFRE_EXTRA_LIBS}
--- a/Makefile
+++ b/Makefile
@@ -20,6 +20,7 @@ PLATFORM    ?= 2
+COFRE_SOURCE_DIR ?= $(SOURCEDIR)/../cofre
@@ -1092,6 +1093,10 @@ payload: native dep_mg dep_shader_shims dep_openal_shim dep_angle_freeze dep_sdl3_guard dep_nggl4es java jre assets shader-glslang-pack $(RENDERER_GAP_PAYLOAD_DEPS)
+	@if [ -d "$(COFRE_SOURCE_DIR)/artifacts/PacketTunnel.appex" ]; then mkdir -p $(WORKINGDIR)/AngelAuraAmethyst.app/PlugIns; cp -R "$(COFRE_SOURCE_DIR)/artifacts/PacketTunnel.appex" $(WORKINGDIR)/AngelAuraAmethyst.app/PlugIns/; fi
