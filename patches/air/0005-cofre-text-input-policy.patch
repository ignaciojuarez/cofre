From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cofre <cofre@example.invalid>
Date: Thu, 29 Oct 2026 12:00:00 -0700
Subject: [PATCH 5/5] [COFRE] Gate SDL keyboard on text focus

Reason: Minecraft 26.x owns text focus; Cofre must suppress an early desktop-style
StartTextInput call and allow UIKit only after SetTextInputArea, while reporting
focus transitions to the Swift input facade.
Drop when: Air exposes a supported text-input focus callback to Cofre.
---
diff --git a/Natives/sdl3_hook.m b/Natives/sdl3_hook.m
index a62ff87..b46cc0f 100644
--- a/Natives/sdl3_hook.m
+++ b/Natives/sdl3_hook.m
@@ -30,6 +30,7 @@
 #import <Foundation/Foundation.h>
 #import <UIKit/UIKit.h>
 #import "utils.h"
+#import "CofreGlue/CofreGameInput.h"
 #include "shader_cap_probe.h"   // ★ [SHADER-CAP] GL 能力探测/诚实上报/入口映射
 extern CALayer *Amethyst_SDL3RenderLayer(void);
 static void ame_applyLauncherResolutionToSDLLayer(void);
@@ -1552,6 +1553,9 @@ static bool ame_SDL_WaitEventTimeoutNS(void *event, int64_t timeoutNS) {
 //     "modifying the autolayout engine from a background thread"
 // 异常虽被 SDL 侧 catch，但布局未能完成，软键盘行为不可预期。
 //
+// Cofre only allows UIKit keyboard presentation after Minecraft supplied a text area.
+// This is the policy seam; diagnostics are emitted by CofreSDLTextInputStateChanged.
+
 // 修法：这类入口若不在主线程，就 dispatch 到主线程执行。文本输入是低频操作，
 // 用 async 避免阻塞渲染线程（也避免主线程同步等待造成死锁）。
 static bool ame_dispatchTextInputToMain(void (^work)(void)) {
@@ -1566,26 +1570,39 @@ static bool ame_dispatchTextInputToMain(void (^work)(void)) {
 
 static bool ame_SDL_StartTextInput(void *window) {
     return ame_dispatchTextInputToMain(^{
+        if (!CofreShouldShowTextInput()) {
+            NSLog(@"[Cofre] SDL_StartTextInput suppressed (no text area)");
+            return;
+        }
         if (ame_real_StartTextInput != NULL) ame_real_StartTextInput(window);
+        CofreSDLTextInputStateChanged(YES, "sdl-start");
     });
 }
 
 static bool ame_SDL_StartTextInputWithProperties(void *window,
                                                  unsigned long long props) {
     return ame_dispatchTextInputToMain(^{
+        if (!CofreShouldShowTextInput()) {
+            NSLog(@"[Cofre] SDL_StartTextInputWithProperties suppressed (no text area)");
+            return;
+        }
         if (ame_real_StartTextInputWithProperties != NULL) {
             ame_real_StartTextInputWithProperties(window, props);
         }
+        CofreSDLTextInputStateChanged(YES, "sdl-start-properties");
     });
 }
 
 static bool ame_SDL_StopTextInput(void *window) {
     return ame_dispatchTextInputToMain(^{
         if (ame_real_StopTextInput != NULL) ame_real_StopTextInput(window);
+        CofreTextInputAreaDidChange(NO);
+        CofreSDLTextInputStateChanged(NO, "sdl-stop");
     });
 }
 
 static bool ame_SDL_SetTextInputArea(void *window, const void *rect, int cursor) {
+    CofreTextInputAreaDidChange(rect != NULL);
     // rect 由调用方栈上持有，且 block 是异步执行的 —— 不能把局部变量的地址
     // 传进 block（函数返回后失效）。改堆分配，由 block 在使用后释放。
     ame_SDLRect *heapRect = NULL;
@@ -1598,6 +1615,7 @@ static bool ame_SDL_SetTextInputArea(void *window, const void *rect, int cursor)
         bool r = ame_real_SetTextInputArea != NULL
                      ? ame_real_SetTextInputArea(window, heapRect, cursor)
                      : false;
+        if (heapRect != NULL) NSLog(@"[Cofre] SDL_SetTextInputArea x=%.0f y=%.0f w=%.0f h=%.0f", heapRect->x, heapRect->y, heapRect->w, heapRect->h);
         free(heapRect);
         return r;
     }
@@ -1605,6 +1623,7 @@ static bool ame_SDL_SetTextInputArea(void *window, const void *rect, int cursor)
     dispatch_async(dispatch_get_main_queue(), ^{
         if (ame_real_SetTextInputArea != NULL) {
             ame_real_SetTextInputArea(window, heapRect, cursor);
+            if (heapRect != NULL) NSLog(@"[Cofre] SDL_SetTextInputArea x=%.0f y=%.0f w=%.0f h=%.0f", heapRect->x, heapRect->y, heapRect->w, heapRect->h);
         }
         free(heapRect);
     });
@@ -1634,7 +1653,7 @@ static bool ame_SDL_InitSubSystem(uint32_t flags) {
             ame_real_SetHint("SDL_OPENGL_FORCE_SRGB_FRAMEBUFFER", "0");
         }
         ame_real_SetHint("SDL_ENABLE_SCREEN_KEYBOARD", "1");
-        NSDebugLog(@"[SDLHook] SDL hint set (screenKeyboard=1, srgb=%s)",
+        NSDebugLog(@"[SDLHook] SDL hint set (screenKeyboard=1; StartTextInput-gated, srgb=%s)",
                    ame_glBridgeEnabled() ? "off" : "default");
     }
     if (ame_real_InitSubSystem != NULL) {
