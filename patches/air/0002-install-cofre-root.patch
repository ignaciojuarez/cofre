From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cofre <cofre@example.invalid>
Date: Thu, 29 Oct 2026 01:00:00 -0700
Subject: [PATCH 2/2] Install Cofre root UI

Reason: make the production app show CofreUI while retaining Air screens behind the facade; Air's launch popups (translation notice, Air updater, version isolation wizard) only run over Air's own UI.
Drop when: Air exposes an official root-controller integration point.
---
 Natives/SceneDelegate.m | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/Natives/SceneDelegate.m b/Natives/SceneDelegate.m
index 7e2ff3629..53c7d59f2 100644
--- a/Natives/SceneDelegate.m
+++ b/Natives/SceneDelegate.m
@@ -1,4 +1,6 @@
 #import "SceneDelegate.h"
+#import <UIKit/UIKit.h>
+extern UIViewController *CofreMakeRootViewController(void);
 #import "ios_uikit_bridge.h"
 #import "utils.h"
 #import "LauncherRootViewController.h"
@@ -85,26 +87,28 @@ - (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session op
     }
 
     [self.window makeKeyAndVisible];
+    UIViewController *cofreRoot = CofreMakeRootViewController();
+    if (cofreRoot) { self.window.rootViewController = cofreRoot; NSLog(@"[Cofre] UI root installed"); }
 
     // 立即应用背景（移除原来的 0.1s 延迟）：
     // 延迟会在启动时露出窗口底色形成"黑条"或"黑闪"。BackgroundManager 在其 init
     // 中已 loadSavedBackground/loadUISettings，单例首次访问即完成初始化，无需延迟。
     [[BackgroundManager sharedManager] applyBackgroundToWindow:self.window];
 
-    [self showTranslationNoticeIfNeeded];
+    if (!cofreRoot) [self showTranslationNoticeIfNeeded];  // Cofre: Air popups only over Air UI
 
     // 启动时自动检查启动器更新（参照 ZL2 LauncherUpgradeViewModel.checkOnAppStart）。
     // 仅当确实存在新版本时才弹窗；请求失败、已是最新、处于限频窗口内一律静默。
     // 延后一拍执行，等 rootViewController 完成首轮布局后再 present。
     dispatch_async(dispatch_get_main_queue(), ^{
-        [UpdateChecker performStartupCheckFromPresenter:self.window.rootViewController];
+        if (!cofreRoot) [UpdateChecker performStartupCheckFromPresenter:self.window.rootViewController];
     });
 
     // ★ [VI-FLOW] B：版本隔离向导 —— 每次进启动器都会再弹，直到用户主动选「以后不再提示」
     //   （哨兵 internal.version_isolation_wizard_off 只在用户点该按钮时写；弹出时【不】写哨兵）。
     //   延后一拍 + 可跳过 ⇒ 绝不阻碍启动；用户随时可从实例设置页的「版本隔离向导」入口重新打开。
     dispatch_async(dispatch_get_main_queue(), ^{
-        [self amePresentVersionIsolationWizardIfNeeded];
+        if (!cofreRoot) [self amePresentVersionIsolationWizardIfNeeded];
     });
 
     // ★ [MP-RESTORE] 联机恢复 —— lazy init：启动路径上**不**创建 TerracottaManager /
