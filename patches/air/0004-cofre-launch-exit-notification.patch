-    BOOL isDir = NO;
-    if ([fm fileExistsAtPath:path isDirectory:&isDir]) {
-        if (isDir) return YES; // 目录已存在
-        // 存在同名普通文件，删除它
-        NSError *removeError = nil;
-        if (![fm removeItemAtPath:path error:&removeError]) {
-            if (error) {
