From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cofre <cofre@example.invalid>
Date: Thu, 29 Oct 2026 14:00:00 -0700
Subject: [PATCH 4/4] Publish Air launch exit notifications

Reason: Cofre owns the launch screen and must turn a pre-first-frame JVM exit into its own failure state instead of showing Air's crash UI.
Drop when: Air exposes a launch failure callback before its crash UI.
---
 Natives/PLLogOutputView.m | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Natives/PLLogOutputView.m b/Natives/PLLogOutputView.m
--- a/Natives/PLLogOutputView.m
+++ b/Natives/PLLogOutputView.m
@@ -186,6 +186,8 @@ + (void)appendToLog:(NSString *)string {
 }
 
 + (void)handleExitCode:(int)code {
+    [[NSNotificationCenter defaultCenter] postNotificationName:@"CofreAirJVMExitNotification"
+                                                        object:nil userInfo:@{@"code": @(code)}];
     if (!current) return;
     
     // 如果有错误，显示新的崩溃界面
