+                                             userInfo:@{NSLocalizedDescriptionKey: [NSString stringWithFormat:localize(@"i18n_str_1128", nil), current, removeError.localizedDescription]}];
+                }
+                return NO;
             }
+        }
+        NSError *createError = nil;
+        if (![fm createDirectoryAtPath:current withIntermediateDirectories:NO attributes:nil error:&createError]) {
+            if (error) *error = createError;
             return NO;
         }
     }
-    NSError *createError = nil;
-    [fm createDirectoryAtPath:path withIntermediateDirectories:YES attributes:nil error:&createError];
-    if (createError) {
-        if (error) *error = createError;
-        return NO;
-    }
     return YES;
 }
 
diff --git a/Natives/installer/ForgeProcessorExecutor.m b/Natives/installer/ForgeProcessorExecutor.m
index bcf7d6e..c867cf2 100644
--- a/Natives/installer/ForgeProcessorExecutor.m
+++ b/Natives/installer/ForgeProcessorExecutor.m
@@ -640,6 +640,18 @@ + (BOOL)preDownloadMojmaps:(NSArray *)processors
     }
     if (!mojmapsVersion) mojmapsVersion = @"";
 
+    // Forge install profiles use both absolute `{MOJMAPS}` paths and older
+    // relative `libraries/...` paths. Normalize the latter before writing.
+    // Without this, NSData writes a relative `net/...` path from the process
+    // working directory and iOS reports: “net” could not be saved in “libraries”.
+    if (![mojmapsOutput isAbsolutePath]) {
+        NSString *relative = [mojmapsOutput stringByStandardizingPath];
+        if ([relative hasPrefix:@"libraries/"]) {
+            relative = [relative substringFromIndex:@"libraries/".length];
+        }
+        mojmapsOutput = [librariesDir stringByAppendingPathComponent:relative];
+    }
+
     if (progress) progress(0.0, localize(@"i18n_str_1327", nil));
     NSLog(@"[ForgeProcExec] Pre-downloading client mappings: version=%@ output=%@", mojmapsVersion, mojmapsOutput);
 
