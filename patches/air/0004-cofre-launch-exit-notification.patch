@@ -36,62 +20,27 @@
     if (![jvm isKindOfClass:[NSArray class]]) return;

-    // -DignoreList= 只出现在 Forge/NeoForge 的 bootstrap 版本 JSON 里，
-    // 找不到就没有 bootstraplauncher 的 JPMS 构建步骤，无需处理。
