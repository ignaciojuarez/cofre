+    NSString *normalized = [path stringByStandardizingPath];
+    NSArray<NSString *> *components = [normalized pathComponents];
+    if (components.count == 0) return YES;
+
+    // Walk every component. A failed install can leave `libraries/net` as a
+    // regular file; createDirectoryAtPath:withIntermediateDirectories: then
+    // fails at that parent even though the requested leaf does not exist.
+    NSString *current = components.firstObject;
+    for (NSUInteger i = 1; i < components.count; i++) {
+        current = [current stringByAppendingPathComponent:components[i]];
+        BOOL isDir = NO;
