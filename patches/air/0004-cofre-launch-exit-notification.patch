+        if (![ignores containsObject:@"lwjgl"]) continue;
+        [ignores removeObject:@"lwjgl"];
+        // An empty prefix matches EVERY jar in BootstrapLauncher.
+        [ignores removeObject:@""];
+        if (ignores.count == 0) [updatedJvm removeObjectAtIndex:i];
+        else updatedJvm[i] = [@"-DignoreList=" stringByAppendingString:[ignores componentsJoinedByString:@","]];
+        changed = YES;
+    }
+    if (!changed) return;
+    NSMutableDictionary *updatedArguments = [arguments mutableCopy];
+    updatedArguments[@"jvm"] = updatedJvm;
+    json[@"arguments"] = updatedArguments;
